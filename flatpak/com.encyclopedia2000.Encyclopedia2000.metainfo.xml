<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream details for the Flatpak (Flathub's page, GNOME Software, KDE Discover). The .deb has its own copy under
     its own id (build/linux/com.svid.encyclopedia2000.metainfo.xml). Add a <release> at the top for each version. -->
<component type="desktop-application">
  <id>com.encyclopedia2000.Encyclopedia2000</id>
  <name>Encyclopedia 2000</name>
  <summary>The CD-ROM encyclopedia, reborn with Wikipedia</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="com.encyclopedia2000">
    <name>Encyclopedia 2000</name>
  </developer>
  <description>
    <p>
      Encyclopedia 2000 brings back the feel of the early-2000s CD-ROM encyclopedia, filled with today's Wikipedia.
      Read articles with pictures, videos, and sounds, explore the world on an interactive map, browse history on a
      timeline, and play learning games and activities.
    </p>
    <p>
      Download Wikipedia to read without an internet connection, keep favorites in folders, and look back through the
      articles you've read.
    </p>
    <p>
      It's free, with no ads and no account, and it collects nothing about you. Articles come live from Wikipedia and
      Wikimedia Commons. Encyclopedia 2000 is an independent project, not affiliated with the Wikimedia Foundation.
    </p>
  </description>
  <launchable type="desktop-id">com.encyclopedia2000.Encyclopedia2000.desktop</launchable>
  <icon type="stock">com.encyclopedia2000.Encyclopedia2000</icon>
  <categories>
    <category>Education</category>
  </categories>
  <keywords>
    <keyword>Wikipedia</keyword>
    <keyword>encyclopedia</keyword>
    <keyword>reference</keyword>
  </keywords>
  <url type="homepage">https://encyclopedia2000.com</url>
  <url type="bugtracker">https://github.com/sburton0/encyclopedia-2000/issues</url>
  <url type="vcs-browser">https://github.com/sburton0/encyclopedia-2000</url>
  <url type="donation">https://donate.encyclopedia2000.com</url>
  <screenshots>
    <screenshot type="default">
      <caption>Home: today's discovery, the Picture of the Day, and the Almanac</caption>
      <image>https://encyclopedia2000.com/images/home.jpg</image>
    </screenshot>
    <screenshot>
      <caption>An article with its pictures</caption>
      <image>https://encyclopedia2000.com/images/article.jpg</image>
    </screenshot>
    <screenshot>
      <caption>World Explorer</caption>
      <image>https://encyclopedia2000.com/images/world-explorer.jpg</image>
    </screenshot>
    <screenshot>
      <caption>Activities</caption>
      <image>https://encyclopedia2000.com/images/activities-grid.jpg</image>
    </screenshot>
    <screenshot>
      <caption>Downloading Wikipedia to read offline</caption>
      <image>https://encyclopedia2000.com/images/offline-library.jpg</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#c9d6ee</color>
    <color type="primary" scheme_preference="dark">#1d2333</color>
  </branding>
  <content_rating type="oars-1.1" />
