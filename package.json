{
  "name": "encyclopedia-2000",
  "version": "0.5.1-beta",
  "private": true,
  "description": "A nostalgic early-2000s style desktop encyclopedia powered by Wikipedia",
  "homepage": "https://encyclopedia2000.com",
  "author": "Scott Burton",
  "license": "GPL-3.0-or-later",
  "main": "main.js",
  "scripts": {
    "setup": "npm install && node node_modules/electron/install.js",
    "start": "electron .",
    "icons": "electron tools/make-icons.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/make-shortcut.ps1",
    "map": "node tools/make-map.mjs",
    "test:app": "node tools/test/run.js",
    "dist": "node tools/patch-uninstaller.js && node tools/sign-nsis-plugins.js && electron-builder --win --publish never -c.electronDist=node_modules/electron/dist",
    "release": "node tools/patch-uninstaller.js && node tools/sign-nsis-plugins.js && electron-builder --win --publish always -c.electronDist=node_modules/electron/dist",
    "stats": "node tools/stats.mjs",
    "offline-data": "node tools/make-onthisday.mjs && node tools/make-featured.mjs",
    "dist:mac": "electron-builder --mac --publish never",
    "release:mac": "electron-builder --mac --publish always",
    "dist:linux": "electron-builder --linux --publish never",
    "release:linux": "electron-builder --linux --publish always"
  },
  "devDependencies": {
    "d3-geo": "^3.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "fzstd": "^0.1.1"
  },
  "build": {
    "appId": "com.svid.encyclopedia2000",
    "productName": "Encyclopedia 2000",
    "copyright": "© 2026 Scott Burton",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "library.js",
      "zim-reader.js",
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "author": {
        "name": "Encyclopedia 2000"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExts": [
        ".dll"
      ],
      "signtoolOptions": {
        "sign": "./tools/sign.js",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": [
          "Scott Burton"
        ]
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Encyclopedia 2000",
      "uninstallDisplayName": "Encyclopedia 2000",
      "artifactName": "Encyclopedia-2000-Installer-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "hardenedRuntime": true,
      "artifactName": "Encyclopedia-2000-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Encyclopedia 2000",
      "artifactName": "Encyclopedia-2000-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "synopsis": "The CD-ROM encyclopedia, reborn with Wikipedia",
      "maintainer": "Encyclopedia 2000 <6220356+sburton0@users.noreply.github.com>",
      "artifactName": "Encyclopedia-2000-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "fpm": [
        "build/linux/com.svid.encyclopedia2000.metainfo.xml=/usr/share/metainfo/com.svid.encyclopedia2000.metainfo.xml"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sburton0",
        "repo": "encyclopedia-2000",
        "releaseType": "release"
      }
    ],
    "portable": {
      "artifactName": "Encyclopedia-2000-Portable-${version}.${ext}"
    }
  }
}
